                playSound('wrong');
                showHabitatToast("🧥 Too tight! Click 'Molt Skin' before eating more!");
                return;
            }
            if (state.leavesEaten < 6) {
                state.leavesEaten += 1;
                playSound('munch');
                if (state.leavesEaten === 2 || state.leavesEaten === 4) {
                    showHabitatToast("🐛 Crunch! The caterpillar grew—time to molt its skin!");
                } else if (state.leavesEaten === 6) {
                    playSound('success');
                    showHabitatToast("🎉 Full grown! Ready to hang in a J-shape and form a chrysalis!");
                } else {
                    showHabitatToast("🌿 Munch, munch! Growing bigger!");
                }
                renderStageInteractive();
            }
        }

        function moltCaterpillar() {
            const needsMolt = (state.leavesEaten === 2 && state.moltCount < 1) || (state.leavesEaten === 4 && state.moltCount < 2);
            if (needsMolt) {
                state.moltCount += 1;
                playSound('molt');
                showHabitatToast("✨ Shed old skin! Now the caterpillar has room to grow!");
                renderStageInteractive();
