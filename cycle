<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Butterfly Life Cycle Explorer - 5th Grade Science</title>
    <!-- Tailwind CSS for responsive layout and utility styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Tone.js for procedural kid-friendly sound effects without external audio files -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <!-- Google Fonts: Fredoka for playful headings and Nunito for clean readability -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(135deg, #e0f2fe 0%, #fef9c3 50%, #dcfce7 100%);
            min-height: 100vh;
            overflow-x: hidden;
            user-select: none;
        }

        h1, h2, h3, .font-display {
            font-family: 'Fredoka', sans-serif;
        }

        /* Custom 3D-style Kid-Friendly Buttons */
        .btn-bouncy {
            transition: all 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 5px 0 rgba(0, 0, 0, 0.18);
        }
        .btn-bouncy:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 7px 0 rgba(0, 0, 0, 0.18);
        }
        .btn-bouncy:active:not(:disabled) {
            transform: translateY(3px);
            box-shadow: 0 2px 0 rgba(0, 0, 0, 0.18);
        }
        .btn-bouncy:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* Animations for Interactive Elements */
        @keyframes wiggle {
            0%, 100% { transform: rotate(-4deg) scale(1.03); }
            50% { transform: rotate(4deg) scale(1.06); }
        }
        .animate-wiggle {
            animation: wiggle 0.4s ease-in-out infinite;
        }

        @keyframes floatSlow {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }
        .animate-float {
            animation: floatSlow 3s ease-in-out infinite;
        }

        @keyframes pulseGlow {
            0%, 100% { filter: drop-shadow(0 0 6px rgba(250, 204, 21, 0.6)); }
            50% { filter: drop-shadow(0 0 18px rgba(250, 204, 21, 0.95)); }
        }
        .animate-glow {
            animation: pulseGlow 1.8s ease-in-out infinite;
        }

        @keyframes flutter {
            0%, 100% { transform: scaleX(1) translateY(0); }
            50% { transform: scaleX(0.45) translateY(-6px); }
        }
        .wings-flutter {
            transform-origin: center;
            animation: flutter 0.35s ease-in-out infinite;
        }

        /* Custom Progress Bar Striping */
        .progress-striped {
            background-image: linear-gradient(
                45deg,
                rgba(255, 255, 255, 0.25) 25%,
                transparent 25%,
                transparent 50%,
                rgba(255, 255, 255, 0.25) 50%,
                rgba(255, 255, 255, 0.25) 75%,
                transparent 75%,
                transparent
            );
            background-size: 1rem 1rem;
        }
    </style>
</head>
<body class="text-slate-800 flex flex-col items-center p-3 sm:p-6">

    <!-- Main App Container -->
    <div class="w-full max-w-5xl flex flex-col gap-4">

        <!-- Header Banner -->
        <header class="bg-white/90 backdrop-blur-md rounded-3xl p-4 sm:px-6 shadow-lg border-4 border-sky-300 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-amber-400 to-orange-500 flex items-center justify-center text-white text-2xl shadow-md">
                    🦋
                </div>
                <div>
                    <h1 class="text-xl sm:text-3xl font-bold text-sky-900 tracking-tight">Metamorphosis Lab</h1>
                    <p class="text-xs sm:text-sm font-bold text-emerald-700">5th Grade Interactive Science Simulation</p>
                </div>
            </div>

            <!-- Controls & Sound Toggle -->
            <div class="flex items-center gap-2 sm:gap-3">
                <button id="soundToggle" onclick="toggleSound()" class="btn-bouncy bg-amber-100 hover:bg-amber-200 text-amber-900 font-bold px-3 py-2 rounded-2xl border-2 border-amber-300 text-sm flex items-center gap-1.5" title="Toggle Sound Effects">
                    <span id="soundIcon">🔊</span>
                    <span class="hidden sm:inline" id="soundLabel">Sound On</span>
                </button>
                <button onclick="openVocabModal()" class="btn-bouncy bg-purple-100 hover:bg-purple-200 text-purple-900 font-bold px-3 py-2 rounded-2xl border-2 border-purple-300 text-sm flex items-center gap-1.5">
                    <span>📖</span>
                    <span>Science Words</span>
                </button>
                <button onclick="resetSimulation()" class="btn-bouncy bg-rose-100 hover:bg-rose-200 text-rose-900 font-bold px-3 py-2 rounded-2xl border-2 border-rose-300 text-sm flex items-center gap-1.5">
                    <span>🔄</span>
                    <span class="hidden sm:inline">Restart</span>
                </button>
            </div>
        </header>

        <!-- 4-Stage Life Cycle Stepper Navigation -->
        <nav aria-label="Life Cycle Stages" class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4">
            <button id="nav-0" onclick="selectStage(0)" class="btn-bouncy rounded-2xl p-3 border-4 text-left flex items-center gap-3 bg-white border-emerald-400 shadow-md">
                <span class="text-2xl sm:text-3xl">🥚</span>
                <div>
                    <div class="text-[11px] font-extrabold uppercase tracking-wider text-emerald-600">Stage 1</div>
                    <div class="font-display font-bold text-sm sm:text-base text-slate-800">The Egg</div>
                </div>
            </button>

            <button id="nav-1" onclick="selectStage(1)" class="btn-bouncy rounded-2xl p-3 border-4 text-left flex items-center gap-3 bg-white/70 border-slate-200 opacity-85">
                <span class="text-2xl sm:text-3xl">🐛</span>
                <div>
                    <div class="text-[11px] font-extrabold uppercase tracking-wider text-lime-600">Stage 2</div>
                    <div class="font-display font-bold text-sm sm:text-base text-slate-800">Larva</div>
                </div>
            </button>

            <button id="nav-2" onclick="selectStage(2)" class="btn-bouncy rounded-2xl p-3 border-4 text-left flex items-center gap-3 bg-white/70 border-slate-200 opacity-85">
                <span class="text-2xl sm:text-3xl">🌿</span>
                <div>
                    <div class="text-[11px] font-extrabold uppercase tracking-wider text-teal-600">Stage 3</div>
                    <div class="font-display font-bold text-sm sm:text-base text-slate-800">Pupa</div>
                </div>
            </button>

            <button id="nav-3" onclick="selectStage(3)" class="btn-bouncy rounded-2xl p-3 border-4 text-left flex items-center gap-3 bg-white/70 border-slate-200 opacity-85">
                <span class="text-2xl sm:text-3xl">🦋</span>
                <div>
                    <div class="text-[11px] font-extrabold uppercase tracking-wider text-orange-600">Stage 4</div>
                    <div class="font-display font-bold text-sm sm:text-base text-slate-800">Adult</div>
                </div>
            </button>
        </nav>

        <!-- Main Interactive Workspace (2-Column on Desktop, Stacked on Mobile) -->
        <main class="grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6 items-stretch">

            <!-- Left/Center Interactive Habitat Canvas (7 Columns) -->
            <section class="lg:col-span-7 bg-white rounded-3xl border-4 border-emerald-300 shadow-xl overflow-hidden flex flex-col justify-between relative min-h-[390px] sm:min-h-[450px]">
                
                <!-- Top Mission Prompt Banner -->
                <div class="bg-gradient-to-r from-emerald-500 to-teal-500 text-white px-4 py-3 flex items-center justify-between gap-2 z-10 shadow-sm">
                    <div class="flex items-center gap-2">
                        <span class="bg-white text-emerald-700 font-extrabold text-xs px-2.5 py-1 rounded-full uppercase">Mission</span>
                        <p id="missionText" class="font-bold text-sm sm:text-base">Keep the egg warm with sunlight and tap it gently to help it hatch!</p>
                    </div>
                </div>

                <!-- Interactive Visual Stage Area -->
                <div id="habitatArea" class="relative flex-1 w-full flex items-center justify-center p-4 overflow-hidden bg-gradient-to-b from-sky-200 via-sky-100 to-emerald-100">
                    <!-- Decorative Clouds & Sun Background -->
                    <div class="absolute top-4 left-6 text-4xl opacity-75 pointer-events-none animate-float">☁️</div>
                    <div class="absolute top-10 right-10 text-3xl opacity-60 pointer-events-none">☁️</div>

                    <!-- Dynamic Stage SVG Container -->
                    <div id="stageVisualContainer" class="w-full h-full flex items-center justify-center relative z-10">
                        <!-- Injected dynamically via JS for crisp interactive SVG graphics -->
                    </div>

                    <!-- Floating Feedback Toast inside Habitat -->
                    <div id="habitatToast" class="pointer-events-none opacity-0 transition-all duration-300 absolute bottom-4 left-1/2 -translate-x-1/2 bg-slate-900/85 text-white font-bold text-sm px-4 py-2 rounded-full shadow-lg whitespace-nowrap z-20">
