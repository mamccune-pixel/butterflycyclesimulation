                    showHabitatToast("🦋 Metamorphosis complete! Ready to emerge!");
                } else {
                    showHabitatToast(`⏱️ Day ${state.chrysalisDays}: Wings and antennae are forming inside!`);
                }
                renderStageInteractive();
            }
        }

        function dryWings() {
            if (!state.wingsDried) {
                state.wingsDried = true;
                playSound('magic');
                showHabitatToast("💨 Wings are strong and dry! Tap a flower to fly!");
                renderStageInteractive();
            }
        }

        function visitFlower(xPos, yPos, flowerName) {
            if (!state.wingsDried) {
                playSound('wrong');
                showHabitatToast("💨 Dry the butterfly's wings first before flying!");
                return;
            }
            state.butterflyPos = { x: xPos, y: yPos };
            state.flowersVisited += 1;
            playSound('munch');

            if (state.flowersVisited === 3) {
                playSound('success');
                showHabitatToast("🌸 Pollinated 3 flowers! The life cycle can begin again!");
                setTimeout(() => openCelebrationModal(), 1100);
            } else {
                showHabitatToast(`🥤 Sipping sweet nectar & carrying pollen from ${flowerName}!`);
            }
            renderStageInteractive();
        }

        // Modals & Reset
        function openVocabModal() {
            playSound('tap');
            document.getElementById('vocabModal').classList.remove('hidden');
        }

        function closeVocabModal() {
            playSound('tap');
            document.getElementById('vocabModal').classList.add('hidden');
        }

        function openCelebrationModal() {
            playSound('success');
            const totalStars = state.starsEarned.filter(Boolean).length;
            document.getElementById('finalStarSummary').textContent = `You earned ⭐ ${totalStars} / 4 Lab Stars!`;
            document.getElementById('celebrationModal').classList.remove('hidden');
        }

        function closeCelebrationModal() {
            playSound('tap');
            document.getElementById('celebrationModal').classList.add('hidden');
        }

        function resetSimulation() {
            playSound('tap');
            state.currentStage = 0;
            state.eggWarmth = 0;
            state.eggTaps = 0;
            state.eggHatched = false;
            state.leavesEaten = 0;
            state.moltCount = 0;
            state.caterpillarFull = false;
            state.chrysalisDays = 0;
            state.chrysalisTransparent = false;
            state.flowersVisited = 0;
            state.wingsDried = false;
            state.butterflyPos = { x: 50, y: 40 };
            state.starsEarned = [false, false, false, false];
            document.getElementById('celebrationModal').classList.add('hidden');
            renderAll();
        }

        // Initialize on page load
        window.onload = function () {
            renderAll();
        };
    </script>
</body>
</html>
