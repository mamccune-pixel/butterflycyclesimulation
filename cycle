                return `
                    <button onclick="answerQuiz(${idx}, ${optIdx})" class="w-full text-left text-xs sm:text-sm p-2.5 rounded-xl border-2 transition-all font-semibold ${btnStyle}">
                        ${solved && optIdx === quiz.correctIndex ? '✅ ' : ''}${opt}
                    </button>
                `;
            }).join('');
