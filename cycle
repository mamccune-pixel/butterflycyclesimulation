                </div>

                <!-- Bottom Stage Interactive Toolbar -->
                <div class="bg-slate-50 border-t-2 border-slate-200 p-3 sm:p-4 flex flex-col gap-3 z-10">
                    <!-- Progress Bar for Current Stage -->
                    <div class="w-full">
                        <div class="flex justify-between text-xs font-extrabold text-slate-600 mb-1">
                            <span id="progressLabel">Warmth & Hatching Progress</span>
                            <span id="progressPercent">0%</span>
                        </div>
                        <div class="w-full h-4 bg-slate-200 rounded-full overflow-hidden p-0.5 border border-slate-300">
                            <div id="progressBar" class="h-full bg-gradient-to-r from-amber-400 to-emerald-500 rounded-full progress-striped transition-all duration-300" style="width: 0%"></div>
                        </div>
                    </div>

                    <!-- Action Buttons specific to current stage -->
                    <div id="actionButtonsContainer" class="flex flex-wrap items-center justify-center gap-2 sm:gap-3">
                        <!-- Dynamically populated buttons -->
                    </div>
                </div>
            </section>

            <!-- Right Science Lab Notebook & Observation Panel (5 Columns) -->
            <aside class="lg:col-span-5 bg-white/95 rounded-3xl border-4 border-amber-300 shadow-xl p-5 flex flex-col justify-between gap-4">
                <div>
                    <!-- Stage Badge & Title -->
                    <div class="flex items-center justify-between gap-2 mb-2">
                        <span id="stageBadge" class="bg-emerald-100 text-emerald-800 font-extrabold text-xs px-3 py-1 rounded-full uppercase tracking-wide border border-emerald-300">
                            Stage 1 of 4
                        </span>
                        <span id="durationBadge" class="text-xs font-bold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-full">
                            ⏱️ ~3 to 5 Days
                        </span>
                    </div>

                    <h2 id="stageTitle" class="text-2xl sm:text-3xl font-bold text-slate-800 mb-2">1. The Egg Stage</h2>
                    
                    <p id="stageDescription" class="text-slate-700 text-sm sm:text-base leading-relaxed mb-4">
                        A mother Monarch butterfly lays tiny, oval eggs on the underside of a <strong>milkweed leaf</strong>. The leaf protects the egg and will become the caterpillar's very first meal!
                    </p>

                    <!-- Science Field Notes Card -->
                    <div class="bg-amber-50 border-2 border-amber-200 rounded-2xl p-4 mb-4">
                        <h3 class="font-display font-bold text-amber-900 text-base flex items-center gap-2 mb-2">
                            <span>🔬</span> 5th Grade Science Facts
                        </h3>
                        <ul id="scienceFactsList" class="space-y-2 text-xs sm:text-sm text-amber-950 font-semibold">
                            <!-- Facts populated by JS -->
                        </ul>
                    </div>

                    <!-- Interactive Observation Check Question -->
                    <div id="quizCard" class="bg-sky-50 border-2 border-sky-200 rounded-2xl p-4">
                        <div class="flex items-center justify-between mb-1.5">
                            <span class="text-xs font-extrabold uppercase text-sky-700">Quick Lab Check</span>
                            <span id="quizStatus" class="text-xs font-bold text-sky-600">Answer to earn a star ⭐</span>
                        </div>
                        <p id="quizQuestion" class="font-bold text-sm text-slate-800 mb-2.5">
                            Why does the butterfly lay its eggs on milkweed leaves?
                        </p>
                        <div id="quizOptions" class="grid grid-cols-1 gap-2">
                            <!-- Quiz options populated by JS -->
                        </div>
                    </div>
                </div>

                <!-- Bottom Next/Prev Navigation Footer -->
                <div class="pt-2 border-t-2 border-slate-100 flex items-center justify-between gap-2">
                    <button id="prevBtn" onclick="prevStage()" class="btn-bouncy bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold px-4 py-2.5 rounded-2xl text-sm">
                        ⬅️ Previous
                    </button>
                    <div class="text-center">
                        <span id="starsCounter" class="font-display font-bold text-amber-500 text-base">⭐ 0 / 4 Stars</span>
                    </div>
                    <button id="nextBtn" onclick="nextStage()" class="btn-bouncy bg-emerald-500 hover:bg-emerald-600 text-white font-bold px-4 py-2.5 rounded-2xl text-sm">
                        Next Stage ➡️
                    </button>
                </div>
            </aside>

        </main>
    </div>

    <!-- Vocabulary Modal (Custom Dialog - Never uses alert()) -->
    <div id="vocabModal" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl border-4 border-purple-400 max-w-lg w-full p-6 shadow-2xl transform transition-all">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-2xl font-bold text-purple-900 flex items-center gap-2">
                    <span>📖</span> Butterfly Science Vocabulary
                </h3>
                <button onclick="closeVocabModal()" class="w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 font-bold text-slate-700 flex items-center justify-center">✕</button>
            </div>
            <div class="space-y-3 max-h-[65vh] overflow-y-auto pr-1 text-sm">
                <div class="p-3 bg-purple-50 rounded-2xl border border-purple-200">
                    <div class="font-bold text-purple-900 text-base">Complete Metamorphosis</div>
                    <p class="text-slate-700">A major life cycle change with four distinct stages: egg, larva, pupa, and adult.</p>
                </div>
                <div class="p-3 bg-lime-50 rounded-2xl border border-lime-200">
                    <div class="font-bold text-lime-900 text-base">Larva (Caterpillar)</div>
                    <p class="text-slate-700">The active eating and growing stage after an insect hatches from an egg.</p>
                </div>
                <div class="p-3 bg-emerald-50 rounded-2xl border border-emerald-200">
                    <div class="font-bold text-emerald-900 text-base">Molting</div>
                    <p class="text-slate-700">Shedding an old, tight outer skin (exoskeleton) so the caterpillar can keep growing bigger.</p>
                </div>
                <div class="p-3 bg-teal-50 rounded-2xl border border-teal-200">
                    <div class="font-bold text-teal-900 text-base">Chrysalis (Pupa)</div>
                    <p class="text-slate-700">The protective shell where the caterpillar transforms into a butterfly.</p>
                </div>
                <div class="p-3 bg-orange-50 rounded-2xl border border-orange-200">
                    <div class="font-bold text-orange-900 text-base">Proboscis</div>
                    <p class="text-slate-700">A long, straw-like tongue butterflies use to sip sweet nectar from flowers.</p>
                </div>
            </div>
            <div class="mt-5 text-right">
                <button onclick="closeVocabModal()" class="btn-bouncy bg-purple-600 hover:bg-purple-700 text-white font-bold px-5 py-2.5 rounded-2xl">
                    Got It!
                </button>
            </div>
        </div>
    </div>

    <!-- Celebration Completion Modal -->
    <div id="celebrationModal" class="hidden fixed inset-0 bg-slate-900/65 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl border-4 border-amber-400 max-w-md w-full p-6 text-center shadow-2xl">
            <div class="text-6xl mb-3 animate-bounce">🦋🎉</div>
            <h3 class="text-2xl sm:text-3xl font-bold text-amber-600 mb-2">Metamorphosis Complete!</h3>
            <p class="text-slate-700 font-semibold text-sm sm:text-base mb-4">
                Amazing job, Junior Entomologist! You guided the butterfly through all four stages of <strong>Complete Metamorphosis</strong> and helped pollinate the garden!
            </p>
            <div id="finalStarSummary" class="bg-amber-50 border-2 border-amber-200 rounded-2xl p-3 font-display font-bold text-amber-900 text-lg mb-5">
                You earned ⭐ 4 / 4 Lab Stars!
            </div>
            <div class="flex gap-3 justify-center">
                <button onclick="closeCelebrationModal()" class="btn-bouncy bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold px-4 py-2.5 rounded-2xl">
                    Keep Exploring
                </button>
                <button onclick="resetSimulation()" class="btn-bouncy bg-emerald-500 hover:bg-emerald-600 text-white font-bold px-5 py-2.5 rounded-2xl">
                    Play Again 🔄
                </button>
            </div>
        </div>
    </div>

    <script>
        /**
         * Butterfly Life Cycle Interactive Simulation
         * Designed for 5th Grade Science (NGSS 3-LS1-1 / 5-LS2-1 aligned)
         */

        // Sound effects controller using Tone.js
        let soundEnabled = true;
        let synth = null;

        function initAudio() {
            if (!synth && typeof Tone !== 'undefined') {
                try {
                    synth = new Tone.PolySynth(Tone.Synth).toDestination();
                    synth.volume.value = -8;
                } catch (e) {
                    console.warn("Audio initialization skipped:", e);
                }
            }
        }

        function playSound(type) {
            if (!soundEnabled) return;
            initAudio();
            if (!synth) return;

            try {
                if (Tone.context.state !== 'running') {
                    Tone.start();
                }
                const now = Tone.now();
                if (type === 'tap') {
                    synth.triggerAttackRelease("C5", "16n", now);
                } else if (type === 'munch') {
                    synth.triggerAttackRelease(["E4", "G4"], "16n", now);
                } else if (type === 'molt') {
                    synth.triggerAttackRelease(["C5", "E5", "G5"], "8n", now);
                } else if (type === 'magic') {
                    synth.triggerAttackRelease(["D5", "F#5", "A5", "D6"], "8n", now);
                } else if (type === 'success') {
                    synth.triggerAttackRelease(["C5", "E5", "G5", "C6"], "4n", now);
                } else if (type === 'wrong') {
                    synth.triggerAttackRelease(["F3", "E3"], "8n", now);
                }
            } catch (e) {
                // Ignore audio errors if user hasn't interacted yet
            }
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            document.getElementById('soundIcon').textContent = soundEnabled ? '🔊' : '🔇';
            document.getElementById('soundLabel').textContent = soundEnabled ? 'Sound On' : 'Muted';
            if (soundEnabled) playSound('tap');
        }

        // Simulation State
        const state = {
            currentStage: 0,
            // Stage 0: Egg
            eggWarmth: 0,
            eggTaps: 0,
            eggHatched: false,
            // Stage 1: Larva
            leavesEaten: 0,
            moltCount: 0,
            caterpillarFull: false,
            // Stage 2: Pupa
            chrysalisDays: 0,
            chrysalisTransparent: false,
            // Stage 3: Adult Butterfly
            flowersVisited: 0,
            wingsDried: false,
            butterflyPos: { x: 50, y: 45 },
            // Quiz Stars earned per stage
            starsEarned: [false, false, false, false]
        };

        // Curriculum Content Data for each stage
        const stagesData = [
            {
                badge: "Stage 1 of 4",
                duration: "⏱️ ~3 to 5 Days",
                title: "1. The Egg Stage",
                mission: "Shine warm sunlight on the egg and gently tap it when ready to hatch!",
                progressLabel: "Egg Warmth & Development",
                description: "A mother Monarch butterfly lays tiny, pinhead-sized eggs on the underside of a <strong>milkweed leaf</strong>. The leaf shelters the egg from predators and provides instant food when the baby hatches.",
                facts: [
                    "🥚 Each egg has a hard outer shell called a <strong>chorion</strong> with tiny ridges.",
                    "🌱 Monarchs only lay eggs on milkweed—it is their special <strong>host plant</strong>.",
                    "👀 Right before hatching, the dark head of the tiny caterpillar shows through!"
                ],
                quiz: {
                    question: "Why does a butterfly lay its eggs on milkweed leaves?",
                    options: [
                        "So the hatching caterpillar has immediate food to eat",
                        "Because milkweed leaves are made of sweet nectar",
                        "To keep the eggs frozen during winter"
                    ],
                    correctIndex: 0
                }
            },
            {
                badge: "Stage 2 of 4",
                duration: "⏱️ ~10 to 14 Days",
                title: "2. Larva (Caterpillar)",
                mission: "Feed the hungry caterpillar milkweed leaves and help it molt as it grows!",
                progressLabel: "Caterpillar Growth & Molting",
                description: "When the larva (caterpillar) hatches, its main job is to <strong>eat and grow</strong>! Because its skin doesn't stretch, it must shed its outer skin (<strong>molt</strong>) 5 times as it grows over 2,000 times larger!",
                facts: [
                    "🐛 First meal: The caterpillar eats its own nutrient-rich eggshell!",
                    "🧥 Each growth phase between molts is called an <strong>instar</strong>.",
                    "🌿 Milkweed toxins stored in the caterpillar's body make birds avoid eating it."
                ],
                quiz: {
                    question: "What is it called when a caterpillar sheds its tight skin to grow bigger?",
                    options: [
                        "Pollination",
                        "Molting",
                        "Hibernation"
                    ],
                    correctIndex: 1
                }
            },
            {
                badge: "Stage 3 of 4",
                duration: "⏱️ ~10 to 14 Days",
                title: "3. Pupa (Chrysalis)",
                mission: "Advance time and observe the transformation inside the green chrysalis!",
                progressLabel: "Metamorphosis Inside Chrysalis",
                description: "The full-grown caterpillar hangs upside down in a <strong>'J' shape</strong> and forms a protective jade-green <strong>chrysalis</strong>. Inside, special cells reorganize the caterpillar's body into wings, antennae, and six legs!",
                facts: [
                    "💎 The gold dots on a Monarch chrysalis help control oxygen and camouflage it.",
                    "🔬 Note: Moths spin fuzzy cocoons, while butterflies form smooth <strong>chrysalides</strong>.",
                    "🧡 On the final day, the chrysalis turns clear so you can see orange wings inside!"
                ],
                quiz: {
                    question: "What happens inside the chrysalis during the pupa stage?",
                    options: [
                        "The caterpillar sleeps without changing at all",
