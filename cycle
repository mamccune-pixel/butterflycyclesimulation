        function tapEgg() {
            if (state.eggHatched) return;
            if (state.eggWarmth < 100) {
                playSound('wrong');
                showHabitatToast("☀️ Shine sunlight on the egg first so it's warm enough to hatch!");
                return;
            }
            state.eggTaps += 1;
            playSound('tap');
            if (state.eggTaps >= 2) {
                state.eggHatched = true;
                playSound('success');
                showHabitatToast("🐛 Pop! A tiny caterpillar hatched from the egg!");
