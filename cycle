            const optionsDiv = document.getElementById('quizOptions');
            optionsDiv.innerHTML = quiz.options.map((opt, optIdx) => {
                let btnStyle = "bg-white hover:bg-sky-100 border-sky-200 text-slate-800";
                if (solved && optIdx === quiz.correctIndex) {
                    btnStyle = "bg-emerald-100 border-emerald-500 text-emerald-900 font-extrabold";
