                    correctIndex: 1
                }
            },
            {
                badge: "Stage 4 of 4",
                duration: "⏱️ ~2 to 6 Weeks",
                title: "4. Adult Butterfly",
                mission: "Dry the butterfly's wings, then tap the flowers to sip nectar & pollinate!",
                progressLabel: "Wing Drying & Flower Pollination",
                description: "The adult butterfly emerges with soft, crumpled wings. After pumping fluid into its wings to dry them, it flies to flowers—sipping nectar with its straw-like <strong>proboscis</strong> and carrying <strong>pollen</strong> from flower to flower!",
                facts: [
                    "🥤 Butterflies taste flowers with sensors on their <strong>feet</strong> and drink with a proboscis.",
                    "🌼 As they drink nectar, pollen sticks to their legs and helps plants reproduce.",
                    "🧭 Monarchs migrate thousands of miles south each autumn!"
                ],
                quiz: {
                    question: "How do adult butterflies help flowering plants in the ecosystem?",
                    options: [
                        "By eating all the flower roots",
                        "By carrying pollen between flowers while sipping nectar",
                        "By spinning webs around the petals"
                    ],
                    correctIndex: 1
                }
            }
        ];

        // Toast Helper inside Habitat
        let toastTimeout = null;
        function showHabitatToast(msg) {
            const toast = document.getElementById('habitatToast');
            toast.textContent = msg;
            toast.classList.remove('opacity-0', 'translate-y-2');
            toast.classList.add('opacity-100', 'translate-y-0');
            clearTimeout(toastTimeout);
